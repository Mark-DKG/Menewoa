  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.js\" && node tests/parity/generate.mjs --check",
    "test:components": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:backup": "bash scripts/test-backup.sh",
    "test:e2e": "playwright test",
