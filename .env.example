# Copy to .env (never commit .env). Only PUBLIC values belong here: every VITE_* variable is
# compiled into the browser bundle. The app refuses to start if it detects a service-role key.
#
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: enables the "Notifications on this device" switch. This is the VAPID PUBLIC key.
# (Generate a pair with: npx web-push generate-vapid-keys)  The private key is NEVER put here.
# VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------------------------
# SERVER-SIDE secrets do NOT go in this file. Set them as Supabase Edge Function secrets:
#   supabase secrets set ALLOWED_ORIGIN=https://your-app.vercel.app
#   supabase secrets set CRON_SECRET=... VAPID_SUBJECT=mailto:you@example.com
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=...
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.)
